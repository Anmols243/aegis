# --- Featherless AI (https://featherless.ai) ---
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Model IDs — verify in the Featherless playground before the build.
# Format is HuggingFace org/model.
MODEL_TRIAGE=            # fast + cheap, e.g. a small Qwen/Llama instruct
MODEL_FORENSIC=moonshotai/Kimi-K3
MODEL_VISION=            # open vision model, Qwen-VL-class
MODEL_REDTEAM=moonshotai/Kimi-K3

# --- AgentBoxD (https://agentboxd.com) ---
AGENTBOXD_API_KEY=
AGENTBOXD_WEBHOOK_SECRET=

# --- Local ---
GRAPH_PATH=data/threat_graph.json
